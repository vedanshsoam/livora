{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLivoraProfileBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_LIVORA_BUCKET"
    },
    {
      "Sid": "ReadAndWriteLivoraProfileObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_LIVORA_BUCKET/profiles/*"
    }
  ]
}